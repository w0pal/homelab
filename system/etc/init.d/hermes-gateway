#!/sbin/openrc-run

name="hermes-gateway"
description="Hermes Agent messaging gateway (profile default)"
command="/home/tomori/.hermes/hermes-agent/hermes"
command_args="--profile default gateway run --quiet"
command_user="tomori:tomori"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/home/tomori/.hermes/gateway-service.log"
error_log="/home/tomori/.hermes/gateway-service.log"
directory="/home/tomori/.hermes/hermes-agent"
supervise_daemon_args="--respawn-delay 5 --respawn-max 0 --respawn-period 0"
supervisor="supervise-daemon"

start_pre() {
	# reapply self-bot patches (idempotent, survives hermes updates)
	su tomori -s /bin/sh -c '/home/tomori/.hermes/selfbot-patch.sh' >/dev/null 2>&1
	checkpath -f -o tomori:tomori -m 0644 "$output_log"
}

depend() {
	need net
	after 9router
}
