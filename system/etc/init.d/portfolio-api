#!/sbin/openrc-run

name="portfolio-api"
description="Portfolio dev API behind the homelab-status funnel"
command="{{HOMELAB_HOME}}/.nix-profile/bin/node"
command_args="--env-file=.env scripts/dev-api.mjs"
command_user="{{HOMELAB_USER}}:{{HOMELAB_USER}}"
directory="{{HOMELAB_HOME}}/storage/Projects/portfolio-web"
pidfile="/run/${RC_SVCNAME}.pid"
supervisor="supervise-daemon"
supervise_daemon_args="--respawn-delay 5 --respawn-max 0 --respawn-period 0"
output_log="{{HOMELAB_HOME}}/.local/log/portfolio-api.log"
error_log="{{HOMELAB_HOME}}/.local/log/portfolio-api.log"

depend() {
	need net
	after local tailscale
}

start_pre() {
	/usr/libexec/rc/bin/checkpath -f -o {{HOMELAB_USER}}:{{HOMELAB_USER}} -m 0644 "$output_log"
}

start_post() {
	if ! {{HOMELAB_HOME}}/.nix-profile/bin/tailscale funnel status 2>/dev/null | /bin/grep -q -- '/homelab-status'; then
		/bin/su {{HOMELAB_USER}} -s /bin/sh -c '{{HOMELAB_HOME}}/.nix-profile/bin/tailscale funnel --bg --https=443 --set-path=/homelab-status http://127.0.0.1:3001/api/homelab' >/dev/null 2>&1
	fi
}
