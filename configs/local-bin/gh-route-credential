#!/bin/sh
# Git credential helper that picks a GitHub account from the repository owner.
# Tokens are read from gh's own secure store through `gh auth token`.
set -eu

REAL_GH="$HOME/.nix-profile/bin/gh"
[ -x "$REAL_GH" ] || REAL_GH=/usr/bin/gh
HOMELAB_OWNER=w0pal
HOMELAB_ACCOUNT=w0pal
DEFAULT_ACCOUNT=w0palphotos

get_owner_from_request() {
  owner=""
  while IFS='=' read -r key value; do
    [ "$key" = path ] || continue
    owner=${value%%/*}
    break
  done
  printf '%s' "$owner"
}

get_owner_from_remote() {
  url=$(git remote get-url origin 2>/dev/null || true)
  case "$url" in
    *github.com:*)
      owner=${url#*github.com:}
      ;;
    *github.com/*)
      owner=${url#*github.com/}
      ;;
    *)
      owner=""
      ;;
  esac
  owner=${owner%%/*}
  owner=${owner%.git}
  printf '%s' "$owner"
}

token_for() {
  "$REAL_GH" auth token -h github.com -u "$1" 2>/dev/null || true
}

owner=$(get_owner_from_request)
[ -n "$owner" ] || owner=$(get_owner_from_remote)

if [ "$owner" = "$HOMELAB_OWNER" ]; then
  account=$HOMELAB_ACCOUNT
else
  account=$DEFAULT_ACCOUNT
fi

token=$(token_for "$account")
if [ -z "$token" ]; then
  account=$DEFAULT_ACCOUNT
  token=$(token_for "$account")
fi

if [ -z "$token" ]; then
  echo "gh-route: no GitHub token for $account" >&2
  exit 1
fi

[ -z "${GH_ROUTE_DEBUG:-}" ] || echo "gh-route: owner=$owner account=$account" >&2

case "${1:-get}" in
  get)
    printf 'protocol=https\nhost=github.com\nusername=%s\npassword=%s\n' "$account" "$token"
    ;;
  *)
    exit 0
    ;;
esac
