#!/sbin/openrc-run
name="9router"
description="9router local router service"
command="/usr/bin/node"
command_args="{{HOMELAB_HOME}}/.npm-global/lib/node_modules/9router/cli.js --no-browser --skip-update -t"
command_user="{{HOMELAB_USER}}:{{HOMELAB_USER}}"
directory="{{HOMELAB_HOME}}"
pidfile="/run/${RC_SVCNAME}.pid"
supervisor="supervise-daemon"
supervise_daemon_args="--respawn-delay 5 --respawn-max 0 --respawn-period 0"
output_log="{{HOMELAB_HOME}}/.9router/9router.log"
error_log="{{HOMELAB_HOME}}/.9router/9router.log"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath -d -o {{HOMELAB_USER}}:{{HOMELAB_USER}} -m 0755 {{HOMELAB_HOME}}/.9router
    checkpath -f -o {{HOMELAB_USER}}:{{HOMELAB_USER}} -m 0644 "$output_log"
}
