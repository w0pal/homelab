# Where to push stats — your deployed portfolio's homelab tracker endpoint
HOMELAB_API_URL=https://your-site.vercel.app/api/homelab
# Must match HOMELAB_TRACKER_TOKEN in the portfolio's Vercel env vars
HOMELAB_TRACKER_TOKEN=
# Push cadence (Now page polls every 3s; lab marks offline after 90s).
# 10s balances live feel against the Upstash daily command budget.
PUSH_INTERVAL_MS=10000
# Optional overrides — auto-detected from the host mounts when empty
HOMELAB_IP=
HOMELAB_USER=
