# Your Discord user token (⚠️ self-bot — at your own risk)
DISCORD_TOKEN=your_user_token_here

# Nous Portal API key (from https://portal.nousresearch.com)
NOUS_API_KEY=sk-nous-...

# Your Discord user ID (owner — always has access)
OWNER_ID=your_discord_user_id_here

# Bot prefix
PREFIX=.pal

# Model
MODEL=stepfun/step-3.7-flash:free

# NaraRouter API key (only needed if using .pal provider nararouter)
# NARAROUTER_API_KEY=sk-nry-...

# Max conversation history per channel
MAX_HISTORY=50

# Gateway cycle timing (ms). Stay connected this long, then go idle this long
# so Discord delivers push notifications. Tune if notifications feel slow.
CONNECTED_MS=2000
IDLE_DELAY_MS=10000

# Channel whitelist (comma-separated IDs). Leave empty for all channels.
# ALLOWED_CHANNELS=123456789012345678,987654321098765432
